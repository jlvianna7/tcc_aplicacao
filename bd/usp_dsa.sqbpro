f.qtd_resposta_sim '% Empresas que utilizam', q.nm_questao_variavel
from ft_ceticbr_mercado f, dm_mercado_atuacao d, dm_dicionario_questoes_ceticbr q
where f.id_dm_mercado = d.id_merc_atuacao  
and f.cd_variavel like 'h3b%'   
and f.id_dm_mercado = 2
and f.cd_variavel = q.cd_questao_ceticbr
order by 1, 4, 3;  
</sql><sql name="SQL 2">SELECT f.ano_pesquisa 'Ano pesquisa', d.ds_merc_atuacao 'Mercado de atuação',  
f.qtd_resposta_sim '% Empresas que utilizam', q.nm_questao_variavel 'Variável' 
from ft_ceticbr_mercado f, dm_mercado_atuacao d, dm_dicionario_questoes_ceticbr q 
where f.id_dm_mercado = d.id_merc_atuacao   
and f.cd_variavel like 'h3b%'   
and f.cd_variavel = q.cd_questao_ceticbr 
order by 1, 4, 3;   
</sql><sql name="SQL 3*">SELECT CMA</sql><current_tab id="2"/></tab_sql></sqlb_project>
